generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================= کاربر و احراز هویت =================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String? // hash شده با bcrypt — برای کاربران Google خالی می‌مونه
  phone         String?   @unique
  image         String?
  role          Role      @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // با هر «خروج از همه‌ی دستگاه‌ها» عوض می‌شود تا همه‌ی JWTهای قبلی بی‌اعتبار شوند
  securityStamp String    @default("initial")

  // کاربرِ سایه‌ای که فقط از «خریدِ مهمان» ساخته شده (بدون رمز عبور) -- اگه
  // بعداً همون ایمیل واقعاً ثبت‌نام کرد، این فلگ true می‌مونه ولی رمز ست می‌شه
  // (نه یه ردیف جدا -- تا تاریخچه‌ی سفارش‌های مهمان قبلی‌ش حفظ بشه)
  isGuest       Boolean   @default(false)
  // کد معرفی -- lazily ساخته می‌شه (نه موقع ساخت کاربر) چون کاربرهای OAuth از
  // مسیر دیگه‌ای (NextAuth adapter) ساخته می‌شن که این‌جا قابل قلاب‌کردن نیست
  referralCode  String?   @unique
  referredById  String?
  // امتیاز وفاداری -- بعد از تحویل کامل هر سفارش اضافه می‌شه (کنار کسراژ ریالی)
  loyaltyPoints Int       @default(0)
  // فقط برای role=STAFF معنا دارد -- JSON array از AdminScope (مثلاً ["SUPPORT"])
  adminScopes   String    @default("[]")
  // محافظت در برابر brute-force: تعداد تلاش‌های ناموفق پیاپی از آخرین موفقیت.
  // با ورود درست صفر می‌شود؛ با رسیدن به آستانه، lockedUntil ست می‌شود
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  accounts      Account[]
  addresses     Address[]
  wishlist      WishlistItem[]
  orders        Order[]
  reviews       Review[]
  wallet        Wallet?
  withdrawalRequests WalletWithdrawalRequest[]
  resetTokens   PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  questions       ProductQuestion[]
  questionReplies QuestionReply[]
  stockNotifications StockNotification[]
  notifications   Notification[]
  supportMessages SupportMessage[]
  notificationSetting NotificationSetting?
  outboundNotifications OutboundNotification[]
  pushSubscriptions PushSubscription[]
  reviewHelpfulVotes ReviewHelpfulVote[]
  priceAlerts PriceAlert[]
  cheaperPriceReports CheaperPriceReport[]
  boughtGiftCards GiftCard[] @relation("GiftCardBuyer")
  redeemedGiftCards GiftCard[] @relation("GiftCardRedeemer")
  sessions UserSession[]
  cartSnapshot CartSnapshot?
  recentlyViewedSnapshot RecentlyViewedSnapshot?
  referredBy   User?   @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    User[]  @relation("Referrals")
  referralRewardsGiven    ReferralReward[] @relation("ReferralRewardsGiven")
  referralRewardsReceived ReferralReward[] @relation("ReferralRewardsReceived")

  @@map("users")
}

// عکسِ لحظه‌ای از سبدخریدِ فعلیِ کاربر (فقط لاگین‌کرده‌ها -- برای یادآوریِ سبدِ
// رهاشده باید بدونیم چی توی سبده و آخرین‌بار کِی عوض شده؛ سبد خودش فقط توی
// localStorage کلاینته). هر تغییر سبد (debounce شده) اینجا sync می‌شه؛ با ثبت
// سفارش یا خالی‌شدنِ سبد حذف می‌شه.
model CartSnapshot {
  id                String @id @default(cuid())
  userId            String @unique
  itemsJson         String // JSON آرایه‌ی CartItem[] کامل -- هم برای یادآوریِ سبدِ رهاشده هم بازیابیِ سبد روی دستگاه دیگر
  savedForLaterJson String @default("[]") // JSON آرایه‌ی CartItem[] -- برای بازیابیِ «خرید بعدی» روی دستگاه دیگر
  updatedAt DateTime @updatedAt
  // پیشرفتِ دنباله‌ی یادآوری: 0=هیچی نرفته، 1=یادآوریِ نرم رفته، 2=یادآوریِ
  // فوریت رفته، 3=به ادمین اطلاع داده شده (تصمیمِ کد تخفیف با خودشه -- دیگه
  // پیامِ خودکاری برای مشتری نمی‌ره). با هر تغییرِ سبد صفر می‌شه (تعامل تازه = دور تازه)
  reminderStage  Int       @default(0)
  lastReminderAt DateTime? // آخرین باری که یه مرحله جلو رفت -- برای فاصله‌گذاریِ درست بین مرحله‌ها
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cart_snapshots")
}

// عکسِ لحظه‌ایِ «اخیراً دیده‌اید»ِ کاربرِ لاگین‌کرده -- عیناً همون الگویِ
// CartSnapshot، برای اینکه این لیست فقط localStorageِ همون مرورگر نباشه و با
// لاگین از دستگاه/مرورگرِ دیگه هم قابل‌بازیابی باشه
model RecentlyViewedSnapshot {
  id        String   @id @default(cuid())
  userId    String   @unique
  itemsJson String // JSON آرایه‌ی RecentlyViewedProduct[]
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recently_viewed_snapshots")
}

// پاداشِ کد معرفی -- وقتی اولین سفارشِ «پرداخت‌شده»‌ی کاربرِ معرفی‌شده ثبت
// می‌شه، یک‌بار به معرف پاداش داده می‌شه. orderId یکتاست (بک‌استاپ برای فراخوانیِ
// هم‌زمانِ چندبارهٔ همین سفارش)، و referredId هم یکتاست (بک‌استاپ برای دو
// سفارشِ هم‌زمانِ همون کاربرِ معرفی‌شده که هر دو priorPaidCount==0 رو ببینن --
// بدون این قید، معرف می‌تونست دوبار پاداش بگیره)
model ReferralReward {
  id           String   @id @default(cuid())
  referrerId   String
  referredId   String   @unique
  orderId      String   @unique
  rewardAmount Int
  createdAt    DateTime @default(now())

  referrer User  @relation("ReferralRewardsGiven", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User  @relation("ReferralRewardsReceived", fields: [referredId], references: [id], onDelete: Cascade)
  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("referral_rewards")
}

enum Role {
  CUSTOMER
  ADMIN
  // دسترسیِ محدود به پنل ادمین -- برخلاف ADMIN که همیشه دسترسیِ کامل داره،
  // STAFF فقط به بخش‌هایی می‌رسه که توی adminScopes برایش تعیین شده (مثلاً
  // فقط پشتیبانی، یا فقط پیگیریِ خریدِ خارجی) -- برای وقتی تیم بزرگ‌تر از
  // یک نفر می‌شه و نمی‌خوایم هرکسی دسترسیِ کامل به کیف‌پول/تنظیمات داشته باشه
  STAFF
}

// حیطه‌های دسترسیِ قابل‌تخصیص به یک حساب STAFF (نه ADMIN، که همیشه کامله)
enum AdminScope {
  SUPPORT // پیام‌های پشتیبانی مشتری
  PURCHASING // پیگیریِ خریدِ کالاهای خارجی (ترندیول/میلا) از سفارش‌ها
  PAYMENTS // تأیید فیش پرداخت + درخواست‌های برداشت کیف‌پول
  PRODUCTS // مدیریت محصولات/دسته‌بندی/برند
  ORDERS // مدیریتِ عمومیِ سفارش‌ها
  SETTINGS // تنظیمات سایت
}

enum UserStatus {
  ACTIVE
  BANNED
}

// توکن یک‌بارمصرف بازیابی رمز عبور -- در محیط توسعه (بدون سرویس ایمیل واقعی)
// لینک بازیابی مستقیم توی همون صفحه نشون داده می‌شه، نه ایمیل واقعی
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// دقیقاً همون الگوی PasswordResetToken، برای تأیید ایمیل بعد از ثبت‌نام --
// هدف: مطمئن شویم ایمیلِ ثبت‌شده واقعاً متعلق به خودِ کاربر است (نه غلط‌تایپی/
// جعلی)، وگرنه اعلان‌های حساس (تأیید سفارش، بازیابی رمز) به آدرس اشتباه می‌رود
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

// NextAuth v5 - مدل Account برای OAuth (گوگل)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// ================= آدرس =================

model Address {
  id         String  @id @default(cuid())
  userId     String
  title      String // مثلا "منزل"، "محل کار"
  fullName   String
  phone      String
  province   String
  city       String
  postalCode String
  detail     String
  isDefault  Boolean @default(false)
  createdAt  DateTime @default(now())

  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@map("addresses")
}

// ================= دسته‌بندی (فقط از DB - همیشه) =================

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  imageUrl  String?
  icon      String? // ایموجی انتخابی دستی برای این دسته (توی منوی دسته‌بندی‌ها استفاده می‌شه) -- اگه خالی باشه، حدس خودکار می‌زنیم
  // لینک محصولات واقعی سایت‌های دیگه (ترندیول، ترندیول‌میلا، ...) برای این دسته دیگه
  // اینجا نیست -- جایگزین شد با مدل عمومی‌تر ExternalSite/ExternalSiteCategoryParam
  // که از چندتا سایت پشتیبانی می‌کنه، نه فقط ترندیول
  parentId  String?
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToCategory")
  products  Product[]
  attributes CategoryAttribute[]
  sizeGuides SizeGuide[]
  externalSiteParams ExternalSiteCategoryParam[]
  createdAt DateTime   @default(now())

  @@map("categories")
}

// ================= برند =================

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  products   Product[]
  sizeGuides SizeGuide[]
  campaigns  Campaign[]

  @@map("brands")
}

// کمپین برند -- بعضی برندها برای یه بازه‌ی زمانی مشخص کمپین تبلیغاتی می‌ذارن (مثلا
// «حراج تابستانه پارسیان‌پوش»)؛ همه‌ی محصولات همون برند در بازه‌ی فعال کمپین زیرش نشون داده می‌شن
model Campaign {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  brandId     String
  bannerImage String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@map("campaigns")
}

// مجموعه‌ی مناسبتی (یلدا، روزِ مادر، بلک‌فرایدی و ...) -- برخلافِ Campaign که
// فقط به یه برند محدوده، اینجا می‌شه از هر برند/دسته‌ای محصول جمع کرد
model OccasionCollection {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  bannerImage String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  items OccasionCollectionItem[]

  @@map("occasion_collections")
}

// مزون: رفرنسِ زنده به Product (قیمت/تخفیف همیشه لحظه‌ای خونده می‌شه). ترندیول:
// اسنپ‌شاتِ عنوان/عکس/قیمت در لحظه‌ی افزودنِ ادمین (مثلِ OrderItem) چون
// کاتالوگِ محلیِ ترندیول نداریم. productKey یه رشته‌ی غیر-nullِ ترکیبیه
// ("mazon:<id>" یا "trendyol:<id>") نه دو فیلدِ جدا -- قیدِ یکتاییِ چندستونی
// روی ستون‌های nullable توی SQLite کار نمی‌کنه (الگوی UnlinkedReviewClaim)
model OccasionCollectionItem {
  id            String        @id @default(cuid())
  collectionId  String
  source        ProductSource
  productKey    String
  productId     String?
  externalId    String?
  title         String?
  image         String?
  price         Int?
  originalPrice Int?
  productUrl    String?
  addedAt       DateTime @default(now())

  collection OccasionCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product?           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productKey])
  @@map("occasion_collection_items")
}

// راهنمای سایز -- فقط یک عکس (از سایت اصلی برند برداشته می‌شه)، مخصوص هر ترکیب دسته‌بندی+برند
// مثلا «شومیز زنانه» + «زارا» یک عکس راهنمای سایز مخصوص خودشون دارن
model SizeGuide {
  id         String   @id @default(cuid())
  categoryId String
  brandId    String
  imageUrl   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brand    Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  rows     SizeChartRow[]

  @@unique([categoryId, brandId])
  @@map("size_guides")
}

// ردیفِ عددیِ یک سایز (علاوه‌بر عکسِ جدولِ SizeGuide) -- برای پیشنهادِ خودکارِ
// سایز از روی قد/وزنِ مشتری. بازه‌ها اختیاری‌اند (بعضی برندها فقط قد یا فقط
// وزن می‌دن)؛ null یعنی «بدون محدودیت در این طرف»
model SizeChartRow {
  id          String   @id @default(cuid())
  sizeGuideId String
  sizeLabel   String // مثلاً "M" یا "38"
  minHeightCm Int?
  maxHeightCm Int?
  minWeightKg Int?
  maxWeightKg Int?
  createdAt   DateTime @default(now())

  sizeGuide SizeGuide @relation(fields: [sizeGuideId], references: [id], onDelete: Cascade)

  @@map("size_chart_rows")
}

// ================= محصول (فقط محصولات مزون - DB-backed) =================
// توجه: محصولات ترندیول از Fake Store API میان و توی این جدول ذخیره نمی‌شن.

model Product {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  brandId     String?
  basePrice   Int // به تومان
  discount    Int      @default(0) // درصد تخفیف
  images      String // JSON array به صورت string ("[\"url1\",\"url2\"]")
  colorImages String   @default("{}") // JSON: {"مقدار رنگ": ["url1","url2"]} -- برای عوض شدن گالری با انتخاب رنگ
  fastShipping Boolean @default(false) // بج «ارسال فوری» توی صفحه محصول -- دستی از پنل ادمین کنترل می‌شه
  // بعضی محصولات (لباس زیر، آرایشی بازشده و...) اصلاً نباید مرجوع بشن -- این
  // فلگ فقط وقتی معنی داره که SITE_SETTING_KEYS.NON_RETURNABLE_PRODUCTS_ENABLED
  // (کلید سراسری) روشن باشه؛ وگرنه همه‌چیز طبق رفتار قبلی قابل‌مرجوعه
  isReturnable Boolean @default(true)
  // محصولِ «ایراد دار» -- کالای واقعی که یه نقصِ جزئی داره (مثلاً ایرادِ دوخت)
  // و به‌جای دور ریختن، شفاف و با تخفیف فروخته می‌شه. پرشدنِ defectNote یعنی
  // این محصول ایراد داره (بجِ «ایراد دار» + توضیحِ نقص + عکسِ نمونه نشون داده
  // می‌شه)؛ مستقل از isReturnable چون منطقاً دو مفهومِ جدان (این یکی «چرا
  // ایراد داره»، اون یکی «قابلِ مرجوعه یا نه») حتی اگه معمولاً با هم بیان
  defectNote  String?
  defectImage String?
  // متنِ جدا از توضیحاتِ کلی -- «نحوه مصرف/نگهداری» (مثلاً دستورِ شست‌وشو برای
  // لباس، یا نحوه‌ی استفاده برای محصولاتی که این‌طور نیازی دارن). فقط مزون،
  // چون محتوای محصولاتِ خارجی دستِ ما نیست
  careInstructions String?
  // ویدیوی رسمیِ محصول -- کنارِ عکس‌ها توی گالریِ صفحه‌ی محصول نشون داده می‌شه
  // (جدا از ویدیوهایی که مشتری‌ها با نظرشون آپلود می‌کنن)
  videoUrl String?
  categoryId  String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    Category           @relation(fields: [categoryId], references: [id])
  brand       Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  attributes  ProductAttribute[]
  variants    ProductVariant[]
  wishlist    WishlistItem[]
  orderItems  OrderItem[]
  reviews     Review[]
  questions   ProductQuestion[]
  flashSales  FlashSale[]
  specifications ProductSpecification[]
  stockNotifications StockNotification[]
  views          ProductView[]
  priceSnapshots PriceSnapshot[]
  priceAlerts PriceAlert[]
  customerShipments CustomerShipment[]
  occasionCollectionItems OccasionCollectionItem[]
  cheaperPriceReports CheaperPriceReport[]

  @@map("products")
}

// بازدید محصول -- هر بار کسی صفحه‌ی محصول رو باز می‌کنه یه ردیف ثبت می‌شه
// (برای نمایش «در ۲۴ ساعت گذشته X نفر بازدید کرده‌اند»)
model ProductView {
  id        String   @id @default(cuid())
  productId String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_views")
}

// عینِ ProductView، ولی برای محصولاتِ ترندیول/میلا -- این‌ها ردیفِ محلیِ Product
// ندارن (contentId مستقیم از خودِ ترندیوله، نه یه FK محلی)، پس نمی‌تونن از
// همون جدول استفاده کنن. برای «نشانه‌ی اجتماعیِ لحظه‌ای» (چند نفر همین چند
// دقیقه‌ی اخیر این محصول رو دیدن) روی صفحه‌ی محصول استفاده می‌شه
model TrendyolProductView {
  id        String   @id @default(cuid())
  contentId String
  createdAt DateTime @default(now())

  @@index([contentId, createdAt])
  @@map("trendyol_product_views")
}

// نمونه‌گیریِ سبک از زبانِ مرورگرِ بازدیدکننده‌ها -- قبل از سرمایه‌گذاری روی
// ترجمه‌ی واقعیِ محتوا (نه فقط قابِ سایت)، باید ببینیم واقعاً چقدر بازدیدکننده‌ی
// غیرفارسی‌زبان داریم. کاملاً ناشناس (بدون userId)، و سمت کلاینت فقط یک‌بار در
// هر مرورگر (با localStorage) ثبت می‌شه تا ترافیکِ یکتا رو نشون بده، نه شمارشِ
// بازدید صفحه رو
model VisitorLocale {
  id          String   @id @default(cuid())
  browserLang String // navigator.language خام (مثلاً "fa-IR"، "tr-TR"، "en-US")
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("visitor_locales")
}

// عکس لحظه‌ای قیمت -- حداکثر یک بار در روز برای هر محصول ثبت می‌شه (وقتی صفحه‌ش بازدید بشه)
// تا بشه فهمید قیمت فعلی نسبت به ۱۰ روز اخیر کمترینه یا نه
model PriceSnapshot {
  id         String   @id @default(cuid())
  productId  String
  price      Int
  recordedAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("price_snapshots")
}

// مشخصات فنی توصیفی محصول - جفت برچسب/مقدار (مثلا "جنس: کتان")
// این‌ها فقط نمایشی‌ان، برخلاف Attribute که برای ساخت ترکیب/variant خرید استفاده می‌شه
model ProductSpecification {
  id        String @id @default(cuid())
  productId String
  label     String // مثلا "جنس"
  value     String // مثلا "کتان"
  order     Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_specifications")
}

// سیستم ژنریک ویژگی/تنوع محصول (سایز، رنگ، هر چیز دیگه)

model Attribute {
  id                String              @id @default(cuid())
  name              String              @unique // مثلا "سایز"، "رنگ"
  groupId           String? // اگه پر باشه، یعنی این ویژگی جایگزین (نه مکمل) بقیه اعضای همین گروهه
  values            AttributeValue[] // مقادیر از پیش‌تعریف‌شده (مثلا S, M, L)
  categories        CategoryAttribute[] // این ویژگی به کدوم دسته‌بندی‌ها وصله
  productAttributes ProductAttribute[] // این ویژگی روی کدوم محصولات استفاده شده
  group             AttributeGroup?     @relation(fields: [groupId], references: [id])
  externalSiteParams ExternalSiteAttributeParam[]

  @@map("attributes")
}

// گروه ویژگی‌های جایگزین -- مثلا "سایز کفش" و "سایز لباس" هر دو تو گروه "سایز" هستن،
// یعنی برای یه محصول فقط یکی از اعضای این گروه معنی داره (نه هر دو با هم)
model AttributeGroup {
  id         String      @id @default(cuid())
  name       String      @unique
  attributes Attribute[]
  createdAt  DateTime    @default(now())

  @@map("attribute_groups")
}

// مقادیر از پیش‌تعریف‌شده هر ویژگی - مثلا برای "سایز": S, M, L, XL
model AttributeValue {
  id          String @id @default(cuid())
  attributeId String
  value       String
  order       Int    @default(0) // ترتیب نمایش، دقیقاً همون ترتیبی که ادمین وارد کرده

  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([attributeId, value])
  @@map("attribute_values")
}

// اتصال ویژگی به دسته‌بندی - یعنی محصولات این دسته می‌تونن از این ویژگی استفاده کنن
model CategoryAttribute {
  id          String  @id @default(cuid())
  categoryId  String
  attributeId String
  fixedValue  String? // اگه پر باشه، یعنی این مقدار برای همه‌ی محصولات این دسته (و زیردسته‌هاش) ثابته
  // مثال: دسته «زنانه» به ویژگی «جنسیت» با fixedValue="زنانه" وصله -- دیگه نیازی نیست
  // هر محصول جدا این مقدار رو انتخاب کنه، خودکار از دسته‌بندی ارث می‌بره

  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([categoryId, attributeId])
  @@map("category_attributes")
}

model ProductAttribute {
  id          String @id @default(cuid())
  productId   String
  attributeId String

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id])

  @@unique([productId, attributeId])
  @@map("product_attributes")
}

// هر ترکیب از مقادیر ویژگی‌ها یک variant با موجودی و قیمت مستقل می‌سازه
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  sku       String  @unique
  stock     Int     @default(0)
  priceDiff Int     @default(0) // اختلاف قیمت نسبت به basePrice (می‌تونه منفی باشه)
  // اندازه‌ی واقعیِ فیزیکیِ این ترکیب (قد، دور کمر، دور باسن، عرض دمپا، ...) --
  // JSON از {label, cm}[]. عمداً یه لیستِ آزاد (نه فیلدهای ثابت مثل waist/hip)
  // چون برشِ لباس‌ها فرق می‌کنه (شلوار با تیشرت یکی نیست) و ادمین دستی پر
  // می‌کنه؛ اختیاریه، بیشترِ محصولات این رو نخواهند داشت. جدا از SizeGuide
  // (که قد/وزنِ مشتری رو به یه سایز پیشنهادی نگاشت می‌کنه) -- این می‌گه خودِ
  // پارچه‌ی این سایزِ همین محصول دقیقاً چند سانت‌ه
  measurements String?

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductVariantValue[]
  orderItems OrderItem[]

  @@map("product_variants")
}

model ProductVariantValue {
  id        String @id @default(cuid())
  variantId String
  attribute String // نام ویژگی، مثلا "سایز"
  value     String // مقدار، مثلا "L" یا "قرمز"

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("product_variant_values")
}

// ================= لیست علاقه‌مندی‌ها (فقط مزون) =================

model WishlistItem {
  id        String        @id @default(cuid())
  userId    String
  // برای مزون: productId پر می‌شه (رابطه‌ی واقعی به جدول Product). برای
  // ترندیول: externalId پر می‌شه و چون جدول محلی برای join‌کردن نداریم،
  // اطلاعات نمایشی (عنوان/عکس/لینک/قیمت) در لحظه‌ی افزودن snapshot می‌شن --
  // ممکنه بعداً قیمت واقعی عوض بشه، برای یه لیست علاقه‌مندی قابل قبوله
  source        ProductSource @default(MAZON)
  productId     String?
  externalId    String?
  externalTitle String?
  externalImage String?
  externalUrl   String?
  externalPrice Int?
  createdAt     DateTime      @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  // هر دو @@unique زیر با وجود nullable بودن productId/externalId درست کار
  // می‌کنن، چون توی SQLite/Postgres چندتا NULL توی یه ایندکس یکتا مجاز و از
  // هم متمایزن -- یعنی ردیف‌های مزون (externalId=NULL) با هم تداخل ایندکس
  // ندارن، و برعکس برای ردیف‌های ترندیول (productId=NULL)
  @@unique([userId, productId])
  @@unique([userId, externalId])
  @@map("wishlist_items")
}

// ================= سفارش =================

model Order {
  id            String        @id @default(cuid())
  userId        String
  addressId     String?
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  // انتخاب مشتری موقع چک‌اوت -- فقط وقتی CASH_ON_DELIVERY_ENABLED (تنظیمات
  // سراسری) روشن باشه قابل‌انتخابه. برای سفارش‌های پرداخت‌درمحل، هیچ دوری از
  // کارت‌به‌کارت (نه دور اقلام، نه دور ارسال/باربری) لازم نیست -- پول موقع
  // تحویل نقدی گرفته می‌شه، پس finalizeItemsPayment/set-shipping-cost مستقیم
  // PAID می‌کنن بدون تخصیص کارت
  paymentMethod PaymentMethod @default(CARD_TRANSFER)
  paymentAuthority String?    @unique
  paidAt        DateTime?
  // پرداخت کارت‌به‌کارت آفلاین -- ادمین از بین کارت‌های ثبت‌شده یکی رو برای این
  // سفارش تخصیص می‌ده (snapshot، نه رابطه -- تا اگه کارت بعداً ویرایش/حذف شد،
  // سفارش‌های قبلی دست‌نخورده بمونن). بعدش مشتری فیش واریزی رو آپلود می‌کنه، تا
  // ادمین از پنل بررسی و تأیید/رد کنه (رد = لغو کامل سفارش)
  assignedCardNumber  String?
  assignedShebaNumber String?
  assignedCardHolder  String?
  receiptImage       String?
  receiptSubmittedAt DateTime?
  deliveredAt   DateTime? // زمان تحویل - برای محاسبه مهلت ۷ روزه مرجوعی
  // آخرین بار که پیام خودکار «حواسمون به سفارشت هست» به مشتری ارسال شد -- برای
  // این‌که این پیام هر چند ساعت یه بار تکرار بشه (نه یه‌بار برای همیشه) ولی
  // اسپم هم نشه
  lastReassurancePingAt DateTime?
  subtotal      Int
  discountTotal Int           @default(0)
  // هزینه ارسال دیگه خودکار حساب نمی‌شه -- ادمین موقع بررسی سفارش (بعد از
  // محاسبه‌ی باربری) دستی وارد می‌کنه. null یعنی «هنوز تعیین نشده»، برخلاف ۰
  // که یعنی «رایگانه» (کد تخفیف FREE_SHIP یا تصمیم دستی ادمین)
  shippingCost  Int?
  // فقط سفارش خارجی -- هزینه‌ی باربری (حمل بین‌المللی ترکیه→ایران)، جدا از
  // shippingCost که تحویل داخلی (انبار باربری تا آدرس مشتری) رو نشون می‌ده
  cargoCost     Int?
  // فقط برای سفارش‌های فقط-مزون پر می‌شه (پست پیشتاز/تیپاکس/...)؛ برای سفارش‌های
  // حاوی کالای خارجی بی‌معنیه چون نحوه‌ی ارسالشون بعد از خرید مشخص می‌شه
  shippingMethod String?
  // موقع ثبت ارسال توسط ادمین پر می‌شه -- بسته به shippingMethod یا کد رهگیری
  // پست/تیپاکسه یا شماره تماس پیک؛ به مشتری هم توی نوتیفیکیشن اطلاع داده می‌شه
  trackingCode String?
  // وضعیت تحویلِ تک‌تک بسته‌ها (چون سفارش ممکنه چند بسته داشته باشه و جزئی
  // تحویل داده بشه). یه رشته‌ی JSON از آرایه‌ی {code, status, arrivedAt} -- همون
  // الگوی trackingCode. وقتی همه‌ی بسته‌ها ARRIVED بشن، کل سفارش DELIVERED می‌شه
  packageStatuses String?
  freeShippingApplied Boolean @default(false)
  // چندبار پست/پیک نتونسته این سفارش رو تحویل بده و بسته برگشت خورده -- فقط
  // برای گزارش/هشدار داشبورد؛ هر بار برگشت یعنی باید دوباره هزینه‌ی ارسال
  // گرفته بشه و چرخه‌ی ارسال از نو تکرار بشه (منطقش توی mark-returned-to-sender)
  returnedToSenderCount Int @default(0)
  // وقتی ادمین اقلام سفارش رو (تعداد/قیمت/افزودن/حذف) ویرایش می‌کنه، مشتری
  // باید ببینه و یا قبول کنه یا خودش دوباره ویرایش کنه -- که در اون صورت باز
  // باید ادمین تأیید کنه. پیش‌فرض AGREED یعنی کسی چیزی رو منتظر طرف مقابل نذاشته
  itemsNegotiationStatus ItemsNegotiationStatus @default(AGREED)
  // زمان دقیقِ آخرین باری که مشتری به ویرایش اقلام پاسخ داد (یعنی رفت روی
  // AWAITING_ADMIN_REVIEW) -- برای ساعت‌شمار هشدار داشبورد، تا با هر آپدیت
  // بی‌ربط دیگه‌ای روی سفارش (که updatedAt رو عوض می‌کنه) ریست نشه
  itemsNegotiationRespondedAt DateTime?
  // نیت مشتری موقع چک‌اوت برای استفاده از کیف‌پول -- چون مبلغ نهایی تا معلوم‌شدن
  // هزینه ارسال کامل نیست، اعمال واقعی کیف‌پول (walletUsed) به لحظه‌ی نهایی‌سازی
  // توسط ادمین موکول می‌شه، نه لحظه‌ی ثبت سفارش
  useWalletRequested Boolean  @default(false)
  total         Int
  giftWrap      Boolean       @default(false)
  couponCode    String?
  walletUsed    Int           @default(0)
  // آدرس به صورت inline هم ذخیره می‌شه تا اگر آدرس بعدا حذف شد، سفارش دست نخورده بمونه
  addressSnapshot String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  // مهلت پرداخت: وقتی مشتری باید پرداخت کند (مرحله‌ی ۱ card-to-card یا مرحله‌ی ۲
  // هزینه ارسال/باربری) تنظیم می‌شود -- اگر این زمان بگذرد و هنوز فیش پرداخت
  // (receipt) ثبت نشده باشد یا وضعیت پرداخت هنوز AWAITING_* باشد، سفارش به‌صورت
  // خودکار لغو می‌شود و منابع (موجودی/کوپن/کیف‌پول) برمی‌گردند
  paymentDeadlineAt DateTime?
  // وقتی ارسالِ این سفارش با یه/چند سفارشِ دیگه (مقصدِ مشترک) ترکیب شده --
  // هزینه‌ی ارسال/باربریِ قبلیِ این سفارش دیگه معتبر نیست، سهمِ جدید مستقیم
  // توی shippingCost همین سفارش نشسته (ShippingGroup.applyShippingCostAdjustment)
  shippingGroupId String?

  user    User                @relation(fields: [userId], references: [id])
  address Address?            @relation(fields: [addressId], references: [id])
  items   OrderItem[]
  statusHistory OrderStatusHistory[]
  returnRequest ReturnRequest?
  cancellationRequest CancellationRequest?
  shippingPayment ShippingPayment?
  messages      OrderMessage[]
  paymentEvents OrderPaymentEvent[]
  referralReward ReferralReward?
  shippingGroup ShippingGroup? @relation(fields: [shippingGroupId], references: [id])

  @@map("orders")
}

// ترکیبِ ارسالِ چند سفارشِ جدا که مقصدشون یکیه و می‌خوان با هم توی یه بسته
// ارسال بشن -- فقط اطلاعاتِ هدرِ ترکیب رو نگه می‌داره؛ آدرس مستقیم از اولین
// سفارشِ عضو خونده می‌شه (نه کپیِ جدا). عمداً یه Order ساختگی نیست چون Order
// همه‌جای این کدبیس فرضِ userId/items واقعی داره
model ShippingGroup {
  id                String   @id @default(cuid())
  totalShippingCost Int
  totalCargoCost    Int      @default(0)
  trackingCode      String?
  createdAt         DateTime @default(now())

  orders Order[]

  @@map("shipping_groups")
}

// گفت‌وگوی مستقیم مشتری/ادمین درباره‌ی یک سفارش خاص -- مثلاً مشتری بخواد سایز
// رو عوض کنه یا سوالی درباره‌ی وضعیت سفارش بپرسه، بدون نیاز به تیکت جدا
model OrderMessage {
  id        String        @id @default(cuid())
  orderId   String
  // خالی یعنی گفت‌وگوی کلیِ سفارش؛ پر یعنی این پیام مخصوصِ یه قلمِ خاصه (مثلاً
  // مشتری درباره‌ی سایز/رنگِ همون کالا سوال داره) -- دو رشته‌ی جدا از هم، نه
  // قاطی، تا گفت‌وگوی کلی شلوغ نشه
  orderItemId String?
  sender    MessageSender
  message   String
  createdAt DateTime      @default(now())

  order Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@map("order_messages")
}

enum MessageSender {
  CUSTOMER
  ADMIN
}

// چت زنده پشتیبانی -- یک مکالمه‌ی سراسری برای هر مشتری (مستقل از سفارش، برخلاف
// OrderMessage که به یک سفارش خاص وصله). adminRead/customerRead برای بجِ
// «پیام نخوانده» دوطرفه‌ست: پیام‌های مشتری که ادمین ندیده، و پیام‌های ادمین
// که مشتری ندیده
model SupportMessage {
  id        String        @id @default(cuid())
  userId    String
  sender    MessageSender @default(CUSTOMER)
  message   String
  adminRead Boolean       @default(false)
  customerRead Boolean    @default(false)
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("support_messages")
}

// هر بار ادمین برای یه دور پرداخت (اقلام یا ارسال/باربری) یه کارت خاص تخصیص
// می‌ده، یه ردیف اینجا ثبت می‌شه -- برخلاف فیلدهای assignedCardNumber روی
// Order/ShippingPayment (که هر بار بازنویسی می‌شن و مقدار قبلی رو گم می‌کنن)،
// این جدول تاریخچه‌ی کامل رو نگه می‌داره تا مشتری/ادمین بتونن ببینن چه مبلغی
// بابت چی، به چه شماره‌کارتی، در چه زمانی واریز/تخصیص شده
model OrderPaymentEvent {
  id          String    @id @default(cuid())
  orderId     String
  round       String // "items" | "shipping"
  purpose     String // توضیح انسانی، مثلاً "هزینه اقلام سفارش" یا "هزینه ارسال و باربری"
  amount      Int
  cardNumber  String?
  cardHolder  String?
  shebaNumber String?
  assignedAt  DateTime  @default(now())
  paidAt      DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_payment_events")
}

enum PaymentStatus {
  PENDING // تازه ثبت شده، منتظر بررسی ادمین و تخصیص شماره کارت
  AWAITING_PAYMENT // ادمین شماره کارت رو تخصیص داد، منتظر واریز و آپلود فیش مشتری
  AWAITING_VERIFICATION // فیش واریزی ارسال شده، منتظر بررسی ادمین
  PAID
  FAILED
}

enum PaymentMethod {
  CARD_TRANSFER // کارت‌به‌کارت + آپلود فیش (رفتار پیش‌فرض/فعلی)
  CASH_ON_DELIVERY // پرداخت نقدی موقع تحویل -- هیچ کارتی تخصیص داده نمی‌شه
}

// وقتی ادمین یا مشتری اقلام سفارش رو ویرایش می‌کنه، این فیلد مشخص می‌کنه نوبت
// کیه که واکنش نشون بده -- برای اینکه سفارش بدون تأیید طرف مقابل مستقیم به
// پرداخت نره
enum ItemsNegotiationStatus {
  AGREED // پیش‌فرض -- کسی چیزی رو منتظر تأیید طرف مقابل نذاشته
  AWAITING_CUSTOMER_REVIEW // ادمین ویرایش کرده، منتظر واکنش مشتریه
  AWAITING_ADMIN_REVIEW // مشتری ویرایش کرده، منتظر بررسی ادمینه
}

// شماره کارت‌های بانکی که ادمین برای پرداخت کارت‌به‌کارت ثبت می‌کنه -- موقع
// بررسی هر سفارش، ادمین یکی از این‌ها رو انتخاب و به مشتری تخصیص می‌ده
model BankCard {
  id          String   @id @default(cuid())
  cardNumber  String
  shebaNumber String? // شماره شبا -- اختیاری، برای مشتری‌هایی که واریز شبایی راحت‌تره
  holderName  String
  label       String? // اختیاری، مثلاً "بانک ملی" -- فقط برای تشخیص راحت‌تر توی لیست ادمین
  isActive    Boolean  @default(true)
  // وقتی «تأییدِ اولیه‌ی ادمین» از تنظیمات خاموشه، سیستم خودش (بدون این‌که
  // ادمین دستی انتخاب کنه) باید یه کارت برای تخصیص به مشتری انتخاب کنه --
  // همینه. پیش‌فرضِ «هزینه‌ی سفارش» (دورِ اول). حداکثر یکی می‌تونه true باشه
  // (توی route اجرا می‌شه، نه constraint دیتابیسی)
  isDefault   Boolean  @default(false)
  // پیش‌فرضِ دورِ دومِ پرداخت -- مستقل از isDefault، چون ممکنه ادمین بخواد
  // کارتِ جدایی برای باربریِ کالای خارجی یا هزینه‌ی ارسالِ مزون تعیین کنه. هر
  // سه فلگ جدا اجرا می‌شن (یه کارت می‌تونه هم‌زمان پیش‌فرضِ چندتا هدف باشه)
  isDefaultForCargo    Boolean @default(false)
  isDefaultForShipping Boolean @default(false)
  createdAt   DateTime @default(now())

  @@map("bank_cards")
}

// دور دوم پرداخت کارت‌به‌کارت، فقط برای هزینه‌ی ارسال سفارش‌های حاوی کالای
// خارجی (ترندیول) -- بعد از این‌که خودِ کالا خریداری/تحویل/وزن‌کشی شد و هزینه‌ی
// واقعی باربری مشخص شد. عمداً جدا از فیلدهای دور اول روی Order نگه داشته شده
// تا تاریخچه‌ی پرداخت دور اول (فیش/کارت همون مرحله) پاک نشه
model ShippingPayment {
  id                  String        @id @default(cuid())
  orderId             String        @unique
  amount              Int // مبلغ باقی‌مانده که باید کارت‌به‌کارت پرداخت شود (بعد از کسر walletOffset)
  shippingCost        Int // تحویل داخلی (انبار باربری تا آدرس مشتری)
  cargoCost           Int // حمل بین‌المللی (ترکیه→ایران)
  // اگه مشتری از قبل موجودی کیف پول داشت (مثلاً بابت رفاند اقلام مغایر)، همون
  // لحظه‌ی تعیین هزینه‌ی ارسال به‌صورت خودکار از این هزینه کسر می‌شه -- amount
  // بالا فقط باقی‌مانده‌ست، نه هزینه‌ی کامل
  walletOffset        Int           @default(0)
  status              PaymentStatus @default(AWAITING_PAYMENT)
  assignedCardNumber  String?
  assignedShebaNumber String?
  assignedCardHolder  String?
  receiptImage        String?
  receiptSubmittedAt  DateTime?
  paidAt              DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("shipping_payments")
}

// تاریخچه تغییر وضعیت سفارش - برای پیگیری زنده با زمان دقیق هر مرحله
model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  // برای محصولات مزون: productId پر می‌شه. برای ترندیول: externalId + source
  productId   String?
  variantId   String?
  externalId  String? // id محصول از Fake Store API
  // فقط برای اقلامِ ترندیولِ واقعی (نه دموی قدیمی) پر می‌شه -- کدوم سایتِ
  // خارجی (ترندیول/میلا) از روی دامنه‌ی لینکِ واقعیِ محصول در لحظه‌ی ثبتِ
  // سفارش تشخیص داده شده. برای غیرقابل‌بازگشت‌بودنِ سطح‌سایت لازمه
  externalSiteId String?
  flashSaleId String?
  source      ProductSource
  title       String // snapshot از عنوان محصول در لحظه خرید
  image       String?
  price       Int // قیمت واحد در لحظه خرید
  quantity    Int
  // سایز/رنگ/ویژگیِ انتخاب‌شده در لحظه‌ی افزودن به سبد (مثلاً "سایز: L / رنگ: قرمز")
  // -- برای ترندیول هیچ variantId ای نداریم، پس این تنها جایی است که این
  // اطلاعات بعد از ثبت سفارش باقی می‌ماند؛ برای مزون هم snapshot ساده‌تر از
  // join زدن با ProductVariant.values در همه‌ی صفحات نمایش سفارش است
  variantLabel String?

  // فقط برای اقلام ترندیول معنی داره -- «در صف خرید» به‌جای یه وضعیت واحد
  // برای کل سفارش، هر قلم جدا پیگیری می‌شه: خریداری شد (با تگ فیزیکی برای
  // ردیابی)، یا ادمین نتونست بخره (رفاند فوری)؛ بعداً وقتی کالا فیزیکی به
  // انبار/نمایندگی می‌رسه، با همون تگ دوباره پیدا می‌شه و نتیجه‌ی نهایی
  // (رسید/گم‌شد/سایز‌اشتباه/رنگ‌اشتباه/دلخواه) ثبت می‌شه
  purchaseStatus      OrderItemPurchaseStatus @default(PENDING)
  purchaseTag         String?                 @unique
  purchaseNote        String? // دلیل کنسلی/گم‌شدن/سایزاشتباه/رنگ‌اشتباه/دلخواه
  purchasePriceActual Int? // قیمت واقعی خریداری‌شده، اگه با price فرق داشت -- تسویه‌ش موقع پرداخت باربری/ارسال
  // اگه سایز/رنگ روی لینک اصلی موجود نبود و ادمین از یه تامین‌کننده/لینک دیگه
  // (با همون کالا) خرید، آدرس واقعی که ازش خریداری شده اینجا ثبت می‌شه -- برای
  // ارجاع بعدی (مثلاً موقع بررسی مغایرت رسیده)، مستقل از لینک اصلی محصول
  purchaseUrl String?
  // وقتی لینک اصلی مشکل داره (ناموجود/تمام‌شده/خراب) و ادمین -- قبل از رسیدن
  // به فاز خرید واقعی -- خودش یه لینک دیگه برای دقیقاً همون کالا (تامین‌کننده‌ی
  // دیگه) پیدا کرده، اینجا ثبت می‌شه؛ کاملاً داخلی/فقط-ادمین، هیچ‌وقت به مشتری
  // نشون داده یا اطلاع داده نمی‌شه
  secondarySourceUrl String?
  // وقتی مشتری از لیستِ «فروشنده‌های دیگر» یه فروشنده‌ی غیرِ پیش‌فرض انتخاب
  // کرده -- تیمِ خرید باید دقیقاً بدونه از کدوم فروشنده بخره (قیمت فروشنده به
  // فروشنده فرق می‌کنه). null یعنی فروشنده‌ی پیش‌فرض/کانونیک (رفتارِ فعلی)
  merchantId   Int?
  merchantName String?
  purchaseResolvedAt  DateTime?
  itemWeightGrams     Int? // وزن این قلم -- برای محاسبه‌ی خودکار هزینه‌ی باربری
  itemCargoCost       Int? // هزینه‌ی باربری این قلم به‌صورت جدا (اگه ادمین دستی وارد کرده باشه)
  // آیا این قلم توسط ادمین بررسی و تائید شده است
  verifyStatus VerifyItemStatus @default(PENDING)
  // لینک نهایی/جایگزین که ادمین با اون تأیید کرد (اگر کالا از تامین‌کننده دیگر خریداری شده)
  verifiedUrl String?
  // زمان رسمی طیق ادمین تایید این قلم
  verifiedAt DateTime?

  // فقط وقتی purchaseStatus="AWAITING_CUSTOMER_DECISION" پر می‌شه -- یادآوریِ
  // این‌که مغایرت اصلی WRONG_SIZE بوده یا WRONG_COLOR، تا اگه مشتری رفاند رو
  // ترجیح داد، وضعیتِ نهاییِ درست (نه یه برچسبِ عمومی) ثبت بشه
  mismatchOutcome     String?
  // اقلام خریداری‌شده‌ی چند سفارش مختلف (حتی مشتری‌های مختلف) که با هم توی یک
  // محموله از ترکیه/دبی/آمریکا ارسال می‌شن -- برای تقسیم هزینه‌ی باربری بر
  // اساس وزن به‌جای این‌که هر سفارش جدا حساب شود
  shipmentId String?

  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product?        @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  flashSale FlashSale?      @relation(fields: [flashSaleId], references: [id])
  externalSite ExternalSite? @relation(fields: [externalSiteId], references: [id], onDelete: SetNull)
  returnItems ReturnRequestItem[]
  shipment  Shipment?       @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  messages  OrderMessage[]
  review    Review?

  @@map("order_items")
}

// یک محمولهٔ ترکیبی: چند قلمِ «خریداری‌شده» (احتمالاً از سفارش‌های مختلف) که
// با هم وزن‌کشی و ارسال می‌شن -- هزینه‌ی باربریِ کل بین اقلام بر اساس سهمِ
// وزنیِ هرکدام تقسیم می‌شه (به‌جای این‌که هر سفارش هزینه‌ی ارسالِ کامل و جدا
// بپردازد)، دقیقاً همون ایده‌ی «خریدِ گروهی/تجمیعِ مرسوله»
model Shipment {
  id               String    @id @default(cuid())
  label            String? // یادداشتِ داخلیِ ادمین، مثلاً "محموله‌ی ۲۵ شهریور - ترکیه"
  totalWeightGrams Int?
  totalCargoCost   Int? // هزینه‌ی باربریِ کل محموله -- بین اقلام بر اساس وزن تقسیم می‌شه
  trackingCode     String?
  shippedAt        DateTime?
  createdAt        DateTime  @default(now())

  items OrderItem[]

  @@map("shipments")
}

enum OrderItemPurchaseStatus {
  PENDING                     // پیش‌فرض -- برای اقلام مزون همیشه همینه، بی‌معنیه
  PURCHASED                   // خریداری و تگ‌گذاری شد، منتظر رسیدن فیزیکی به انبار/نمایندگی
  RECEIVED                    // فاز دوم: سالم به انبار/نمایندگی رسید (یا مشتری با مغایرت موافقت کرد)
  CANCELLED                   // فاز اول: ادمین نتونست بخرد (ناموجود و...) -- رفاند فوری
  LOST                        // Faz دوم -- رفاند فوری
  WRONG_SIZE                  // فاز دوم -- مشتری رفاند رو ترجیح داد -- رفاند فوری
  WRONG_COLOR                 // Faz دوم -- مشتری رفاند رو ترجیح داد -- رفاند فوری
  ISSUE_OTHER                 // Faz دوم، دلیل دلخواه -- رفاند فوری
  AWAITING_CUSTOMER_DECISION  // Faz دوم: مغایرت (سایز/رنگ) پیدا شد -- منتظر تصمیم_customer (نگه‌داشتن یا رفاند)
}

enum VerifyItemStatus {
  PENDING       // بررسی نشده
  CONFIRMED     // موجود بود / admin تأیید کرد
  REPLACED      // از تامین‌کننده دیگر وارد شد -- لینک جایگزین
}

enum ProductSource {
  MAZON
  TRENDYOL
}

// ================= نظرات (مزون و ترندیول) =================

// بک‌استاپِ اتمیکِ مسیرِ عمومیِ نظر (بدونِ orderItemId مشخص): چکِ «قبلاً نظرِ
// unlinked برای این محصول ثبت نکرده» + create توی POST /api/reviews عمداً
// داخلِ یه $transaction‌ان، ولی خودِ transaction این ترکیب رو اتمیک نمی‌کنه --
// دو درخواستِ هم‌زمان می‌تونن هر دو همون چکِ findFirst رو قبل از هر دو create
// ببینن (دقیقاً همون کلاسِ رِیسی که FIRST_BUY/ReferralReward داشتن).
// productKey عمداً یه رشته‌ی غیر-nullِ ترکیبیه ("mazon:<id>" یا "trendyol:<id>")
// نه دو فیلدِ جدا -- قیدِ یکتاییِ چندستونی روی ستون‌های nullable طبقِ استاندارد
// SQL کار نمی‌کنه (NULL با NULL برابر شمرده نمی‌شه، پس دو ردیف با
// externalId=NULL یکسان همچنان «متفاوت» حساب می‌شن و قید رد نمی‌کنتشون)
model UnlinkedReviewClaim {
  id         String @id @default(cuid())
  userId     String
  productKey String

  @@unique([userId, productKey])
  @@map("unlinked_review_claims")
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  // برای مزون: productId پر می‌شه. برای ترندیول: externalId + source، دقیقاً
  // مثل الگوی WishlistItem/OrderItem -- این‌ها نظرات واقعی مشتری‌های مُداشاپن،
  // نه import از خودِ ترندیول (که اصلاً چنین داده‌ای رو اسکرپ نمی‌کنیم)
  source        ProductSource @default(MAZON)
  productId     String?
  externalId    String?
  // ترندیول و میلا هر دو زیرِ همون source=TRENDYOL جمع می‌شن ولی سایتِ واقعاً
  // متفاوتی‌ان با contentId های مستقل -- بدونِ این فیلد، یه externalId مشترک
  // بین دو سایت باعث می‌شه نظراتِ محصولِ سایتِ دیگه هم زیرِ این محصول نمایش
  // داده بشه. برای خریدِ تأییدشده از رویِ OrderItem.externalSiteId پر می‌شه
  // (نه از کلاینت)؛ برای مسیرِ عمومی از کلاینت می‌آد. نظراتِ قدیمی‌ترِ قبل از
  // این فیلد null می‌مونن (هنوز مبهم‌ان، ولی نظراتِ تازه درست جدا می‌شن)
  externalSiteId String?
  // اگه این نظر از دکمه‌ی «نظر بده» زیرِ یه قلمِ سفارشِ مشخص اومده (نه فرمِ
  // عمومیِ صفحه‌ی محصول)، اینجا پر می‌شه -- همین باعث می‌شه یه مشتری بتونه
  // همون محصول رو دوباره بخره و برای اون خریدِ جدید هم جدا نظر بده (شاید بارِ
  // دوم تجربه‌ش فرق کرده)، به‌جای این‌که فقط یه نظرِ کلی برای همیشه داشته باشه
  orderItemId String? @unique
  rating    Int // 1 تا 5
  comment   String
  images    String   @default("[]") // JSON array به صورت string (مثل images محصول) -- عکس‌های ضمیمه‌ی نظر
  verifiedPurchase Boolean @default(false)
  // ترکیبِ واقعاً خریداری‌شده (مثلاً "سایز: L / رنگ: قرمز")، از روی همون
  // OrderItem.variantLabel که verifiedPurchase رو هم توش پیدا کردیم -- فقط
  // برای خریدِ تأییدشده پر می‌شه؛ به بازدیدکننده‌های بعدی کمک می‌کنه بفهمن این
  // نظر درباره‌ی کدوم سایز/رنگه (مهم برای پوشاک)
  variantLabel String?
  // عکسِ لحظه‌ای از عنوان/عکسِ محصول در لحظه‌ی ثبتِ نظر -- برای مزون از روی
  // Product قابل join‌شدنه، ولی برای ترندیول محصولِ محلی نداریم (فقط externalId)،
  // پس کلاینت (که همون لحظه صفحه‌ی محصول رو می‌بینه) می‌فرستدش. تنها مصرفش
  // «دیوارِ ویدیو»ی صفحه‌ی اصلیه -- تا لازم نباشه به‌ازای هر ویدیو یه فچِ زنده‌ی
  // ترندیول بزنیم؛ صرفاً نمایشیه، منبعِ واقعیِ قیمت/موجودی هیچ‌وقت این نیست
  productTitle String?
  productImage String?
  isApproved Boolean @default(false) // تا وقتی ادمین تایید نکنه، زیر محصول نمایش داده نمی‌شه
  // پاسخ تیم مُداشاپ به نظر (مثل پاسخ فروشنده روی آمازون)
  adminReply String?
  repliedAt DateTime?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  helpfulVotes ReviewHelpfulVote[]

  @@map("reviews")
}

// رأی «مفید بود» برای هر نظر -- هر کاربر حداکثر یک رأی؛ دوباره کلیک = پس‌گرفتن
model ReviewHelpfulVote {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@map("review_helpful_votes")
}

// ================= پرسش و پاسخ محصول =================

model ProductQuestion {
  id        String   @id @default(cuid())
  // برای مزون: productId پر می‌شه. برای ترندیول: externalId + source (همون الگوی Review)
  source        ProductSource @default(MAZON)
  productId     String?
  externalId    String?
  userId    String? // پرسنده -- سوال‌های قدیمی‌تر این فیلد رو ندارن، پس نال‌پذیره
  question  String
  answer    String?
  createdAt DateTime @default(now())
  answeredAt DateTime?

  product Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  replies QuestionReply[]

  @@map("product_questions")
}

// پیام‌های بعدی همون گفتگو -- هم پرسنده‌ی اصلی می‌تونه دوباره بنویسه، هم ادمین
model QuestionReply {
  id         String   @id @default(cuid())
  questionId String
  userId     String
  message    String
  isAdmin    Boolean  @default(false)
  createdAt  DateTime @default(now())

  question ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id])

  @@map("question_replies")
}

// ================= گزارشِ قیمتِ مناسب‌تر =================

enum CheaperPriceReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

// کاملاً یه کانالِ ارتباطیِ دستیِ مشتری->ادمین -- مشتری می‌گه همین کالا رو
// جای دیگه ارزون‌تر دیده، ادمین خودش تصمیم می‌گیره. هیچ مقایسه/اسکرپِ خودکاری
// انجام نمی‌شه. «رد» یعنی status=DISMISSED نه حذفِ کامل (برخلافِ الگوی
// ProductQuestion) چون این گزارش‌ها ارزشِ آماری/رقابتی دارن و ادمین شاید
// بعداً بخواد تاریخچه‌شون رو مرور کنه
model CheaperPriceReport {
  id            String                   @id @default(cuid())
  userId        String?
  source        ProductSource            @default(MAZON)
  productId     String?
  externalId    String?
  reportedPrice Int
  note          String?
  status        CheaperPriceReportStatus @default(PENDING)
  adminNote     String?
  createdAt     DateTime                 @default(now())
  resolvedAt    DateTime?

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("cheaper_price_reports")
}

// ================= کیف پول =================

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0) // به تومان
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id          String            @id @default(cuid())
  walletId    String
  type        WalletTxType
  amount      Int // همیشه مثبت؛ جهت واریز/برداشت از type مشخص می‌شه
  description String
  orderId     String?
  createdAt   DateTime          @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
}

enum WalletTxType {
  TOPUP // شارژ کیف پول
  PURCHASE // پرداخت با کیف پول در سفارش
  REFUND // بازگشت وجه (مثلا بعد از لغو سفارش)
  WITHDRAWAL // درخواست واریز موجودی کیف پول به حساب مشتری
  LOYALTY // کسراژ/امتیاز وفاداری -- بعد از تحویل کامل سفارش به کیف پول اضافه می‌شه
  GIFT_CARD // فعال‌سازی کارت هدیه -- موجودی کارت به کیف پول اضافه می‌شه
  REFERRAL // پاداش کد معرفی -- بعد از اولین سفارش پرداخت‌شده‌ی کاربر معرفی‌شده
}

// درخواست مشتری برای واریز موجودی کیف پولش به حسابش -- موجودی همون لحظه‌ی
// درخواست از کیف پول کسر می‌شه (تا دوبار خرج نشه)؛ اگه ادمین رد کرد، به کیف
// پول برمی‌گرده
model WalletWithdrawalRequest {
  id           String                    @id @default(cuid())
  userId       String
  amount       Int
  cardNumber   String
  shebaNumber  String?
  holderName   String
  status       WalletWithdrawalStatus    @default(PENDING)
  receiptImage String? // عکس فیش واریزیِ ادمین به حساب مشتری -- فقط برای PAID
  rejectReason String?
  createdAt    DateTime                  @default(now())
  resolvedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallet_withdrawal_requests")
}

enum WalletWithdrawalStatus {
  PENDING
  PAID
  REJECTED
}

// ================= کارت هدیه =================
// کارت هدیه: کاربر با موجودی کیف پولش کارت می‌خره (کد + مبلغ + پیام + ایمیل
// گیرنده) و گیرنده با واردکردن کد، موجودی کارت را به کیف پول خودش شارژ می‌کنه.
// کد یکبارمصرف است؛ ادمین می‌تونه کارت بسازه (قرعه‌کشی/جایزه) یا غیرفعالش کنه.
model GiftCard {
  id               String    @id @default(cuid())
  code             String    @unique // کد فعال‌سازی، مثل "HDA-7K2M-9QX1"
  initialAmount    Int // مبلغ اولیه به تومان
  balance          Int // موجودی باقی‌مانده (بعد از فعال‌سازی صفر)
  message          String? // پیام خریدار روی کارت
  recipientEmail   String? // ایمیل گیرنده (اختیاری)
  buyerUserId      String? // null = ساخته‌ی ادمین
  redeemedByUserId String? // کی فعالش کرده
  redeemedAt       DateTime?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  expiresAt        DateTime? // null = بدون انقضا

  buyerUser     User? @relation("GiftCardBuyer", fields: [buyerUserId], references: [id], onDelete: SetNull)
  redeemedByUser User? @relation("GiftCardRedeemer", fields: [redeemedByUserId], references: [id], onDelete: SetNull)

  @@index([buyerUserId])
  @@map("gift_cards")
}

// ================= کوپن تخفیف =================

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  type           CouponType
  value          Int // درصد (برای PERCENT) یا مبلغ ثابت به تومان (برای FIXED) - برای FREE_SHIP/FIRST_BUY نادیده گرفته می‌شه
  minOrderAmount Int        @default(0)
  maxUses        Int? // null = نامحدود
  usedCount      Int        @default(0)
  isActive       Boolean    @default(true)
  expiresAt      DateTime?
  // نمایشِ این کد به‌صورت یه بجِ تبلیغاتی روی صفحه‌ی محصولاتِ مزون (مثل «با کد
  // تخفیف X 20% تخفیف بگیر») -- پیش‌فرض خاموش، چون همه‌ی کدهای فعال لزوماً
  // برای تبلیغِ عمومی نیستن (مثلاً کدِ مخصوصِ یه کمپینِ ایمیلی/معرفی). فقط
  // مزون چون قیمت/تخفیفِ محصولاتِ خارجی دستِ ما نیست
  showcaseOnProducts Boolean @default(false)
  createdAt      DateTime   @default(now())

  @@map("coupons")
}

// بک‌استاپِ اتمیکِ کوپنِ FIRST_BUY: قبل از ساختِ تراکنش، تعدادِ سفارش‌های
// قبلیِ کاربر چک می‌شه، ولی این چک به‌تنهایی در برابرِ دو درخواستِ هم‌زمان
// امن نیست (هر دو می‌تونن صفر ببینن). پس داخلِ همون تراکنشی که سفارش ساخته
// می‌شه، یه ردیف اینجا هم درج می‌شه -- userId یکتاست، پس تلاشِ دومِ هم‌زمان
// با P2002 شکست می‌خوره. با لغوِ سفارش (restoreOrderResources) پاک می‌شه تا
// «اولین خرید» واقعاً معنیِ سفارشِ لغونشده رو حفظ کنه.
model FirstBuyClaim {
  id        String   @id @default(cuid())
  userId    String   @unique
  orderId   String
  createdAt DateTime @default(now())

  @@map("first_buy_claims")
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIP
  FIRST_BUY // فقط برای اولین خرید کاربر معتبره
}

// ================= حراج فلش =================

model FlashSale {
  id              String   @id @default(cuid())
  productId       String
  discountPercent Int // درصد تخفیف حراج (جایگزین تخفیف عادی محصول در بازه زمانی فعال)
  stock           Int // موجودی مخصوص حراج، جدا از موجودی عادی variant ها
  startsAt        DateTime
  endsAt          DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("flash_sales")
}

// ================= مرجوعی و بازگشت وجه =================

model ReturnRequest {
  id          String       @id @default(cuid())
  orderId     String       @unique // هر سفارش فقط یک درخواست مرجوعی می‌تونه داشته باشه
  userId      String
  reason      ReturnReason
  description String? // توضیح تکمیلی (مثلا برای "سایر دلایل")
  status      ReturnStatus @default(PENDING)
  refundAmount Int // مبلغی که در نهایت به کیف پول برمی‌گرده
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  order Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items ReturnRequestItem[]

  @@map("return_requests")
}

// اگه مشتری چند دلیل مرجوعی مختلف داشته باشه که هرکدوم مربوط به یه کالای
// خاصه (مثلاً کالای اول معیوبه، کالای دوم فقط سایزش اشتباهه)، هرکدوم یه ردیف
// جدا اینجا می‌گیره -- reason/description سطح‌بالای خودِ ReturnRequest برای
// حالت ساده‌ی «کل سفارش یه دلیل داره» (سازگاری با قبل) همچنان باقی می‌مونه
model ReturnRequestItem {
  id              String       @id @default(cuid())
  returnRequestId String
  orderItemId     String
  reason          ReturnReason
  description     String?

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])

  @@map("return_request_items")
}

enum ReturnReason {
  DEFECTIVE // کالای معیوب
  WRONG_ITEM // ارسال کالای اشتباه
  WRONG_SIZE // سایز/مشخصات نامناسب
  CHANGED_MIND // انصراف بدون دلیل خاص
  OTHER
}

enum ReturnStatus {
  PENDING // در انتظار بررسی
  APPROVED // تأیید شد، منتظر ارسال کالا از طرف مشتری
  REJECTED // رد شد
  ITEM_RECEIVED // کالا برگردونده شد و رسید
  REFUNDED // وجه به کیف پول برگشت
}

// ================= درخواست لغو سفارش =================
// سفارش‌های دارای کالای خارجی (ترندیول) مستقیماً لغو نمی‌شن -- چون ادمین ممکنه
// الان وسط خریدِ واقعی از فروشنده باشه، حتی اگه هیچ قلمی PURCHASED نشده. مشتری
// فقط یه *درخواست* لغو ثبت می‌کنه و ادمین با تکیف خودش تأیید یا ردش می‌کنه.
// تأیید یعنی کل سفارش CANCELLED + بازگشت کامل منابع (موجودی/کوپن/کیف‌پول).
// رد یعنی هیچ اتفاقی نمی‌افته -- سفارش دست‌نخورده می‌مونه.
enum CancellationRequestStatus {
  PENDING // در انتظار بررسی ادمین
  APPROVED // ادمین تأیید کرد -- سفارش لغو شد و منابع برگشتن
  REJECTED // ادمین رد کرد -- سفارش دست‌نخورده موند
}

model CancellationRequest {
  id        String                      @id @default(cuid())
  orderId   String                      @unique // هر سفارش فقط یه درخواست لغو فعال می‌تونه داشته باشه
  userId    String
  reason    String
  status    CancellationRequestStatus   @default(PENDING)
  adminNote String? // پیام ادمین هنگام رد/تأیید (مثلاً «فعلاً وسط خرید هستیم»)
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("cancellation_requests")
}

// متن‌های عمومی سایت که ادمین بتونه بدون نیاز به کد، تغییرشون بده -- مثل شرایط مرجوعی
// ذخیره‌ی کلید-مقدار ساده؛ هر متن جدید فقط یه ردیف جدیده، نیازی به migration نداره
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ================= نرخ ارز =================
// نرخ روزانه‌ی هر ارز به تومان + درصد سود ما -- دستی توی پنل ادمین ثبت/به‌روز
// می‌شه. قیمت نمایشی محصولات سایت‌های خارجی = قیمت ارزی × rate × (1 +
// profitPercent/100)، همیشه با نرخ ذخیره‌شده‌ی *فعلی* لحظه‌ی محاسبه (نه نرخ
// لحظه‌ی سفارش قدیمی) -- طبق تصمیم مهدی، عمداً قفل/snapshot نمی‌شه.
model ExchangeRate {
  id            String   @id @default(cuid())
  currency      String   @unique // کد ارز، مثلاً "TRY"، "USD"، "EUR"
  currencyLabel String // اسم فارسی برای نمایش توی پنل، مثلاً "لیر ترکیه"
  rate          Float // نرخ پایه‌ی خرید هر ۱ واحد ارز، به تومان
  profitPercent Float    @default(0) // درصد سودی که روی نرخ پایه اضافه می‌کنیم
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@map("exchange_rates")
}

// «موجود شد خبرم کن» -- روی یه ترکیب خاص از ویژگی (مثلا "سایز: L") نه لزوما یه variant دقیق،
// چون وقتی چند ویژگی با هم ترکیب می‌شن، یه مقدار به‌تنهایی معادل یه variant واحد نیست
model StockNotification {
  id            String    @id @default(cuid())
  userId        String
  productId     String
  description   String // مثلا "سایز: L" یا "سایز: 36 / رنگ: سبز"
  notifiedAt    DateTime?
  // تا کِی این نفر اولویتِ اطلاع‌رسانی داره (صرفاً برای ترتیب پیام، نه رزرو واقعی موجودی)
  reservedUntil DateTime?
  createdAt     DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, description])
  @@map("stock_notifications")
}

// هر بار ادمین پوسترِ یه محصول رو ساخت و عکس(ها)ش رو دانلود کرد، یه ردیف اینجا
// ثبت می‌شه -- یعنی «این پست توی اینستاگرام گذاشته شده». فقط برای هشدارِ
// «قبلاً این رو گذاشتی» (وقتی همون محصول دوباره لود بشه) و فیلترکردنِ
// پیشنهادهای پوسترِ بعدی (نباید چیزیو که قبلاً پست شده دوباره پیشنهاد بده)
// استفاده می‌شه -- نه یه آنالیتیکسِ کامل، پس عمداً ساده نگه داشته شده. محصولِ
// خارجی (ترندیول/میلا) توی جدولِ Product ما وجود نداره، پس فقط شناسه‌ی
// خامِ سایت (contentId+siteSlug) ذخیره می‌شه، نه رابطه‌ی FK
model InstagramPosterLog {
  id              String   @id @default(cuid())
  contentId       String
  siteSlug        String
  name            String
  image           String?
  price           Int?
  originalPrice   Int?
  discountPercent Int?
  postedAt        DateTime @default(now())

  @@index([contentId, siteSlug])
  @@map("instagram_poster_logs")
}

// «کاهش قیمت خبرم کن» -- وقتی قیمت مؤثرِ محصول (با احتساب تخفیف/حراج فلش) به
// targetPrice یا کمتر برسه، یک‌بار اطلاع می‌دهیم (notifiedAt پر می‌شه) و با
// ثبت دوباره (re-arm) فعال می‌شود. حداکثر یک اخطار فعال برای هر محصول/کاربر.
model PriceAlert {
  id          String    @id @default(cuid())
  userId      String
  productId   String
  targetPrice Int // اگر قیمت <= این مقدار شد خبر بده
  notifiedAt  DateTime? // null = هنوز فعال؛ پر = قبلاً اطلاع داده شده (یک‌بارمصرف)
  createdAt   DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("price_alerts")
}

// اعلان‌های داخل سایت -- بدون نیاز به ایمیل/پیامک، فقط زنگوله‌ی بالای هدر
model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ترجیحات اعلانِ خارج از سایت (ایمیل/پیامک) -- به‌ازای هر کاربر یک ردیف
// (خودکار با مقادیر پیش‌فرض ساخته می‌شه). برای هر کانال، لیستی از رویدادهایی
// که نباید بفرستیم به‌صورت JSON رشته ذخیره می‌شه؛ اگر خالی باشد یعنی همه‌چیز
// روی کانال فعال است.
model NotificationSetting {
  id                  String   @id @default(cuid())
  userId              String   @unique
  emailOn             Boolean  @default(true)
  smsOn               Boolean  @default(false)
  // برخلاف ایمیل/پیامک که فقط یه سوییچه، پوش نیاز به subscription واقعیِ
  // مرورگر داره (مدل PushSubscription) -- این فلگ فقط ترجیحِ کاربره، نه
  // اینکه واقعاً subscription فعالی وجود دارد یا نه (اون رو موقع ارسال چک می‌کنیم)
  pushOn              Boolean  @default(false)
  emailDisabledEvents String   @default("[]") // JSON array از کلیدهای NotificationEvent
  smsDisabledEvents   String   @default("[]")
  pushDisabledEvents  String   @default("[]")
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

// اشتراکِ Web Push مرورگرِ یک کاربر -- هر مرورگر/دستگاه یک ردیف جدا (کاربر
// می‌تونه هم از موبایل هم از دسکتاپ ثبت‌نام کرده باشه)؛ endpoint خودش یکتا
// و شناسه‌ی طبیعیِ همون اشتراکِ مرورگره. p256dh/auth کلیدهای رمزنگاریِ
// استانداردِ Web Push (RFC 8291) هستن که مرورگر موقع subscribe برمی‌گردونه.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// لاگ اعلان‌های ارسال‌شده به خارج از سایت (ایمیل/پیامک). status:
// "SENT" ارسال واقعی شد (پراوایدر پیکربندی شده)، "LOGGED" در محیط توسعه
// بدون پراوایدر فقط ثبت شد، "FAILED" خطای پراوایدر.
model OutboundNotification {
  id        String   @id @default(cuid())
  userId    String
  channel   String // "EMAIL" | "SMS"
  eventType String
  to        String
  subject   String?
  body      String
  status    String // "SENT" | "LOGGED" | "FAILED"
  error     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("outbound_notifications")
}

// لاگِ خودکارِ خطاهای سرور (نسخه‌ی خودمیزبانِ ساده‌ی چیزی مثل Sentry) -- از
// طریق instrumentation.ts (خطاهای سمتِ سرور: روت‌ها/کامپوننت‌ها) و
// global-error.tsx (خطاهای رندرِ سمتِ کلاینت) پر می‌شه. بدون این، اگه یه چیزی
// توی production خراب بشه (مثلاً توی مسیرِ پرداخت)، هیچ‌کس خبردار نمی‌شه مگر
// خودِ مشتری شکایت کنه.
model ErrorLog {
  id         String    @id @default(cuid())
  message    String
  stack      String?
  // JSON آزاد: مسیر/روت، userId (اگه لاگین بود)، و هر چیزِ کمکیِ دیگه
  context    String?
  source     String // "SERVER" | "CLIENT"
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@map("error_logs")
}

// ثبتِ اقدام‌های حساسِ ادمین/کارمند -- برخلاف OrderStatusHistory (که فقط چی و
// کِی رو ثبت می‌کنه)، اینجا مشخصه *کی* این کار رو کرده. عمداً adminId رابطه‌ی
// FK نیست (فقط رشته‌ی خام) و adminName/adminEmail هم snapshot لحظه‌ی ثبت‌ان --
// همون الگوی OrderItem.title -- تا اگه بعداً حساب کارمند حذف شد، تاریخچه‌ی
// اقداماتش هم پاک/بی‌معنی نشه
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  adminName  String
  adminEmail String
  action     String // کلید کوتاه، مثلاً "PAYMENT_APPROVED"، "STAFF_CREATED"
  targetType String? // مثلاً "Order"، "User"، "WalletWithdrawalRequest"
  targetId   String?
  detail     String? // توضیح آزاد یا JSON کوتاه
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([adminId])
  @@map("admin_audit_logs")
}

// ================= سایت‌های خارجی (ترندیول، ترندیول‌میلا، و بعداً هر سایت دیگه) =================
// هدف: بتونیم برای هر دسته‌بندی/ویژگی مزون، بگیم توی هر سایت خارجی معادلش با چه
// پارامتر URL ساخته می‌شه، و از روی این نگاشت‌ها لینک نهایی رو خودکار بسازیم.
// مثال: پوشاک مردانه سایز L روی ترندیول = baseUrl + wc=75 + wg=2 + vr=size|group-l

// آینه‌ی محلی درخت دسته‌بندی ترندیول (اسم اصلی ترکی + آیدی واقعی) که با دکمه‌ی
// «به‌روزرسانی همه» توی پنل ادمین از API عمومی ترندیول پر/به‌روز می‌شه. اسم
// فارسی (nameFa) رو ادمین دستی وارد می‌کنه؛ هر بار «به‌روزرسانی همه» دوباره
// زده بشه، فقط ردیف‌های جدید/تغییرکرده لمس می‌شن، ترجمه‌های قبلی دست‌نخورده
// می‌مونن. مستقل از ExternalSite چون این taxonomy بین trendyol.com و
// trendyol-milla.com مشترکه.
// هر بار درخواستی به ترندیول با خطا مواجه بشه (چه موقع اعتبارسنجی فیلتر، چه
// موقع لود اولیه‌ی صفحه، چه موقع «بارگذاری بیشتر») این‌جا ثبت می‌شه -- تا
// بشه بعداً دقیقاً همون شرایط رو شبیه‌سازی کرد و روش کار کرد، به‌جای اینکه
// فقط یه پیام کلی به کاربر نشون داده بشه و خطا برای همیشه گم بشه
model TrendyolFetchLog {
  id        String   @id @default(cuid())
  url       String
  error     String
  source    String // "check-url" | "page-load" | "load-more"
  siteSlug  String?
  createdAt DateTime @default(now())

  @@map("trendyol_fetch_logs")
}

// نگاشت contentId (شناسه‌ی محصول ترندیول) به آدرس کامل trendyol.com -- چون
// URL داخلی مداشاپ برای صفحه‌ی محصول فقط از contentId + یه اسلاگ سئو ساخته
// می‌شه (مثل خودِ ترندیول)، ولی برای fetch واقعی صفحه از ترندیول به آدرس
// کاملش نیاز داریم. این ردیف یه‌بار وقتی کاربر روی کارتی در گرید کلیک می‌کنه
// (جایی که p.url کامل رو از قبل داریم) ذخیره می‌شه، و صفحه‌ی جزئیات بعداً
// از همینجا می‌خونتش.
model TrendyolProductUrlCache {
  id        String   @id @default(cuid())
  contentId String   @unique
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("trendyol_product_url_cache")
}

// کشِ لایوِ گرید/سرچِ ترندیول -- قبلاً یه Map حافظه‌ای بود (کامنتِ قبلیِ همین
// فایل صراحتاً هشدار داده بود که "با ری‌استارت سرور یا چند instance پاک/
// ناهماهنگ می‌شه")؛ روی Vercel که هر درخواست ممکنه سرورلسِ متفاوتی اجرا بشه،
// این یعنی عملاً کش خیلی وقت‌ها اصلاً hit نمی‌خورد و هر بار دوباره زنده از
// ترندیول کشیده می‌شد -- دقیقاً همون چیزی که ریسکِ ۴۰۳/چالش رو زیاد می‌کنه.
// این جدول همون کش رو بینِ همه‌ی instance ها مشترک می‌کنه؛ key همون URL
// درخواستیه، data نتیجه‌ی JSON.stringify شده
model TrendyolLiveCache {
  key       String   @id
  data      String
  expiresAt DateTime

  @@index([expiresAt])
  @@map("trendyol_live_cache")
}

// همه‌ی گروه‌های فیلتر واقعی ترندیول (رنگ، برند، نوع کیف، ...) و مقادیرشون --
// هم عنوان خودِ گروه (با valueId خالی) هم تک‌تک مقادیرش یه ردیفن. با دکمه‌ی
// «به‌روزرسانی» توی پنل ادمین (با دادن یه wc/wg نمونه) پر/به‌روز می‌شه.
// مثل TrendyolCategoryCache، فقط ترجمه‌های جدید (nameFa خالی) دست‌نخورده
// می‌مونن؛ برای برندها معمولاً نیازی به ترجمه نیست (اسم خاصن) و همون Turkish
// می‌مونه -- تا وقتی nameFa خالیه، نمایش از nameTr میاد
// ترندیول (trendyol.com) و میلا (trendyol-milla.com) دو سایت واقعاً جدا هستن
// -- ممکنه یه برند/دسته/کد فیلتر توی یکی باشه و توی دیگری نباشه، یا کدش فرق
// کنه. برای همین کش‌های زیر (TrendyolCategoryCache/TrendyolFilterCache) باید
// به‌ازای هر سایت جدا نگه داشته شن
enum ExternalSiteKind {
  TRENDYOL
  TRENDYOL_MILLA
}

model TrendyolFilterCache {
  id                  String   @id @default(cuid())
  site                ExternalSiteKind @default(TRENDYOL)
  filterKey           String // کلید گروه توی aggregations ترندیول، مثلا "Renk" یا "WebBrand" یا "348"
  valueId             String // "" یعنی این ردیف خودِ عنوان گروهه، نه یه مقدار داخلش
  nameTr              String // اسم ترکی (یا عنوان گروه یا متن مقدار)
  nameFa              String?
  nameFaSuggested     Boolean  @default(false)
  // ادمین دستی می‌گه «این نیاز به ترجمه نداره» (مثلاً کدهای سایز عجیبی مثل
  // "10XL" که تشخیص خودکارِ عددی/بازه‌ای شناساییش نکرده) -- با این تیک، از
  // لیست عادی پنهون می‌شه، ولی توی یه لیست جدا («فقط بدون‌نیاز به ترجمه») قابل بازبینی می‌مونه
  noTranslationNeeded Boolean  @default(false)
  groupTitleTr        String? // برای ردیف‌های مقدار (نه خودِ گروه)، اسم گروه مادر برای نمایش بهتر توی پنل
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([site, filterKey, valueId])
  @@map("trendyol_filter_cache")
}

// دیکشنری کلمه‌به‌کلمه‌ی اصطلاحات مد ترکی -- برای ساختن ترجمه‌ی خودکارِ
// عنوان محصولات ترندیول بدون نیاز به API خارجی. هر ردیف یه توکن ترکی (یا
// عبارت چندکلمه‌ای پرتکرار مثل "Uzun Kol") رو به فارسی نگاشت می‌کنه.
// termTr همیشه lowercase ذخیره می‌شه تا lookup حساس به بزرگ/کوچیکی حروف نباشه.
model TrendyolTitleTermDictionary {
  id        String   @id @default(cuid())
  termTr    String   @unique // اصطلاح ترکی، lowercase، بدون فاصله‌ی اضافه
  termFa    String // معادل فارسی -- برای ردیف‌های noTranslationNeeded همون termTr ذخیره می‌شه
  priority  Int      @default(0) // برای عبارت‌های چندکلمه‌ای که با هم تداخل دارن -- بزرگ‌تر اول امتحان می‌شه
  // ادمین دستی می‌گه «این کلمه نیاز به ترجمه نداره» (مثلاً برند یا اسم خاص) --
  // با ثبت این، از لیست «کلمات ناشناخته» (unknown-terms) دیگه حذف می‌شه، چون
  // همون‌جوری که هست (termFa=termTr) به دیکشنری اضافه شده و دیگه "ناشناخته" نیست
  noTranslationNeeded Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("trendyol_title_term_dictionary")
}

// الگوهای دستیِ ادمین برای ترجمه‌ی اسمِ کمپین‌های ترندیول -- برای موردهایی که
// دیکشنریِ کلمه‌به‌کلمه‌ی بالا بهم می‌ریزتشون (چون شاملِ عدد/درصدن، مثلِ
// "2 Ürün %30 İndirim"). ادمین خودش الگوی ترکی رو با placeholderهای
// {1},{2},... مشخص می‌کنه (هرکدوم یعنی یه عددِ دلخواه)، و قالبِ فارسی رو هم با
// همون placeholderها می‌نویسه -- مثلاً الگو: "{1} Ürün %{2} İndirim"، قالب:
// "خرید {1}م ٪{2} تخفیف". هیچ رجکسِ خامی گرفته نمی‌شه، فقط این نحوِ ساده
model TrendyolCampaignNameFormula {
  id         String   @id @default(cuid())
  patternTr  String   @unique
  templateFa String
  priority   Int      @default(0) // وقتی چند الگو ممکنه هم‌زمان مچ بشن -- بزرگ‌تر اول امتحان می‌شه
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("trendyol_campaign_name_formulas")
}

// کمپین‌هایی که ادمین صریحاً خواسته اصلاً نمایش داده نشن -- طبقِ درخواستِ
// صریح، کنارِ ترجمه‌ی هر کمپین یه تیکِ «غیرفعال» هست؛ با تیک‌زدن، campaignId
// (همون آیدیِ خودِ ترندیول -- مشترک بینِ همه‌ی محصولاتی که توی همون کمپینِ
// خاص شرکت دارن) اینجا ثبت می‌شه و از اون به بعد، روی هر محصولی که این
// کمپین رو داشته باشه، اصلاً توی campaignBadges نمی‌آد (نه فقط مخفیِ CSS)
model TrendyolHiddenCampaign {
  id         String   @id @default(cuid())
  campaignId Int      @unique
  rawNameTr  String // فقط برای مرجع/بررسیِ دستیِ بعدی -- خودِ فیلترشدن با campaignId انجام می‌شه
  createdAt  DateTime @default(now())

  @@map("trendyol_hidden_campaigns")
}

// کش عنوان کامل هر محصول -- تا هر بار محصول لود می‌شه نیازی به دوباره
// tokenize کردن و جایگزینی نباشه. originalTitle کلید یکتاست چون عنوان دقیق
// محصول تغییر نمی‌کنه (برخلاف قیمت/موجودی).
model TrendyolTitleCache {
  id             String   @id @default(cuid())
  originalTitle  String   @unique
  translatedTitle String
  // چندتا توکن که توی دیکشنری پیدا نشدن (برای این‌که ادمین ببینه چی رو باید
  // به دیکشنری اضافه کنه) -- جدا شده با "|"
  unknownTerms   String?
  // نسخه‌ی الگوریتم ترجمه‌ای که این ردیف رو تولید کرده -- هر بار الگوریتم
  // tokenizeAndTranslate توی trendyolTitleTranslation.ts عوض بشه (مثلاً معکوس
  // کردن ترتیب کلمات، یا حذف کلمات ناشناخته)، عدد ثابت TITLE_ALGO_VERSION
  // توی کد یکی بالا می‌ره. اگه این عدد با نسخه‌ی فعلی یکی نباشه، یعنی این ردیف
  // با الگوریتم قدیمی ساخته شده و باید از نو ترجمه بشه -- وگرنه بعد از هر
  // بهبود الگوریتم، عنوان‌های قبلاً کش‌شده برای همیشه با نسخه‌ی قدیمی/غلط می‌موندن
  algorithmVersion Int    @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("trendyol_title_cache")
}

// کمپین‌های واقعیِ ترندیول («۲ عدد و بیشتر ۴۰ لیر تخفیف» و مشابه) که هر بار
// جزئیاتِ یه محصول واکشی می‌شه کشف/به‌روز می‌شن (نه یه کرالِ کامل از کل
// ترندیول -- فقط همون کمپین‌هایی که حداقل یه محصولش روی خودِ سایتِ ما دیده
// شده). صفحه‌ی اصلی از همینجا «کمپین‌های ترندیول» رو نشون می‌ده تا کاربر بدون
// این‌که اول باید یه محصول خاص رو باز کند، مستقیم به لیستِ محصولاتِ آن کمپین برسد.
model TrendyolDiscoveredCampaign {
  id          String           @id @default(cuid())
  campaignId  Int // همون promotions[].id ترندیول -- برای ساختنِ لینکِ /campaign/{id}
  site        ExternalSiteKind @default(TRENDYOL)
  text        String // متنِ ترجمه‌شده‌ی نمایشی
  // اسمِ خامِ ترکی -- بدونش امکاناتِ ادمینِ صفحه‌ی «محصولاتِ این کمپین» (تعریف/
  // ویرایشِ الگو) در دسترس نیست چون نیاز به متنِ خام دارن، نه فقط ترجمه‌شده.
  // nullable چون ردیف‌های قدیمی (قبل از این فیلد) این رو ندارن -- تا دفعه‌ی
  // بعد که همون کمپین دیده بشه، خودکار پر می‌شه (recordDiscoveredCampaigns)
  rawNameTr   String?
  sampleImage String? // عکسِ همون محصولی که این کمپین رو لو داد -- برای کارتِ صفحه‌ی اصلی
  // چندتا عکسِ نمونه‌ی دیگه (JSON آرایه، حداکثر ۶ تا، به‌مرور از محصولاتِ
  // مختلفی که همین کمپین رو دارن جمع می‌شه) -- برای کمپین‌های چندمحصولی مثلِ
  // «۴ بگیر ۳ پرداخت کن» که خودِ ترندیول هم چندتا عکسِ نمونه نشون می‌ده؛
  // کمپین‌های تخفیفِ سبدخرید (DiscountOnBasket) اصلاً عکس نمی‌گیرن
  sampleImages String @default("[]")
  discountType String? // promotionDiscountType خامِ ترندیول -- تصمیمِ نمایشِ عکس بر همین اساسه
  // از promotions[].promotionEndDate -- اگه گذشته باشه، دیگه از صفحه‌ی اصلی
  // حذف می‌شه (کمپین‌های بدونِ این فیلد، null می‌مونن و صرفاً با lastSeenAt
  // قدیمی‌شدن به‌مرور از فهرست می‌افتن)
  endsAt      DateTime?
  firstSeenAt DateTime         @default(now())
  lastSeenAt  DateTime         @default(now())

  @@unique([campaignId, site])
  @@index([lastSeenAt])
  @@map("trendyol_discovered_campaigns")
}

model TrendyolCategoryCache {
  id              String   @id @default(cuid())
  site            ExternalSiteKind @default(TRENDYOL)
  // چندتا مسیر متفاوت (مثلا "Kadın > Giyim" و "Anne & Çocuk > Erkek Çocuk")
  // می‌تونن کاملاً مشروع به یه wc= مشترک اشاره کنن -- برای همین اینجا @unique
  // نیست (اگه بود، یکی این‌ها رو بازنویسی می‌کرد و بقیه گم می‌شدن)
  param           String // پارامتر واقعی، مثلا "wc=82" یا "wc=104443,1123,104444"
  nameTr          String // اسم اصلی (ترکی) که از منوی ترندیول میاد
  nameFa          String? // ترجمه‌ی فارسی -- تا وارد نشه null می‌مونه
  // بعضی دسته‌ها چند معادلِ رایج فارسی دارن (مثلاً «Bluz» هم «بلوز» هم
  // «شومیز» ترجمه می‌شه) -- nameFa همیشه معادلِ اصلی/نمایشی (چیپ، بردکرامب)
  // می‌مونه؛ این فیلد فقط معادل‌های اضافه‌ست، با کاما جدا («شومیز,تاپ»)، و فقط
  // برای *تشخیصِ* جست‌وجو (matchSearchQueryToCategory) استفاده می‌شه، نه نمایش
  nameFaSynonyms  String?
  // true یعنی این ترجمه خودکار (فرهنگ‌لغت داخلی) یا از طریق import گروهی
  // اومده و هنوز ادمین دستی تأییدش نکرده؛ همین که ادمین از پنل ویرایشش کنه
  // (PATCH)، false می‌شه
  nameFaSuggested Boolean  @default(false)
  // مسیر کامل -- هر گره‌ی منو توی یه سایت دقیقاً یه‌جای مشخص توی درخته، مثلا
  // "Kadın > Giyim > Elbise"؛ ولی چون همین مسیر متنی توی دو سایت جدا هم ممکنه
  // تکرار شه، یکتایی با site ترکیب شده (پایین‌تر)، نه به‌تنهایی
  path            String
  // میلا منوی دسته‌بندیِ درختیِ خودش رو ندارد (فروشگاه تک‌برنده) -- برای همین
  // دسته‌بندی‌های ترندیول به‌عنوان نقطه‌ی شروع براش کپی می‌شن، ولی خیلی‌هاشون
  // روی میلا اصلاً محصولی ندارن. هر بار که جست‌وجوی واقعی برای یه دسته (روی
  // یه سایت خاص) صفر نتیجه برگردوند، همین‌جا ثبت می‌شه تا دیگه توی
  // منو/سایدبار همون سایت پیشنهاد نشه -- بدون اینکه لازم باشه از قبل بدونیم
  // کدوم دسته‌ها خالی‌ان
  confirmedEmpty   Boolean   @default(false)
  confirmedEmptyAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([site, path])
  @@map("trendyol_category_cache")
}

model ExternalSite {
  id        String   @id @default(cuid())
  name      String // مثلاً "ترندیول"
  slug      String   @unique // مثلاً "trendyol"
  baseUrl   String // شامل ? انتهایی، مثلاً "https://www.trendyol.com/sr?"
  // واحد پول این سایت (کد ISO مثل "TRY"، "USD"، "EUR") -- باید یک ردیف
  // متناظر توی جدول ExchangeRate داشته باشه تا قیمت‌هاش به تومان تبدیل بشه.
  // پیش‌فرض TRY چون فعلاً همه‌ی سایت‌های فعال (ترندیول/ترندیول‌میلا) ترکی‌ان
  currency  String   @default("TRY")
  isActive  Boolean  @default(true)
  // مثل Product.isReturnable ولی برای کالاهای خارجی -- چون این سایت‌ها محصولِ
  // خودشون توی DB ما ذخیره نمی‌شه، فلگِ مرجوعی روی سطحِ خودِ سایت (نه هر
  // محصول) تنظیم می‌شه؛ فقط وقتی SITE_SETTING_KEYS.NON_RETURNABLE_PRODUCTS_ENABLED
  // روشن باشه معنی داره
  isReturnable Boolean @default(true)
  // مقایسه‌ی فروشنده‌ی فعلی با فروشنده‌های دیگرِ همون محصول -- این فیچر ذاتاً
  // مخصوصِ سایت‌هایی مثلِ ترندیوله (که چند فروشنده زیرِ یه لیستینگ دارن)؛ مزون
  // اصلاً همچین مفهومی نداره، پس برخلافِ isReturnable نیازی به یه فلگِ سراسریِ
  // «تنظیماتِ عمومی» جدا نداره -- کاملاً مشخصاتِ خودِ همین سایته
  showOtherSellers Boolean @default(true)
  createdAt DateTime @default(now())

  categoryParams  ExternalSiteCategoryParam[]
  attributeParams ExternalSiteAttributeParam[]
  orderItems      OrderItem[]

  @@map("external_sites")
}

// پارامتر دسته‌بندی مخصوص هر سایت -- مثلاً برای دسته‌ی «پوشاک» روی ترندیول: "wc=75"
model ExternalSiteCategoryParam {
  id         String  @id @default(cuid())
  siteId     String
  categoryId String
  param      String // مثلاً "wc=75" -- کامل با کلید و مقدار، آماده‌ی چسبوندن به URL
  isDefault  Boolean @default(false) // تیک «به عنوان صفحه‌ی اول» -- این دسته جزو فیلترهای پیش‌فرض همین سایته

  site     ExternalSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  category Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([siteId, categoryId])
  @@map("external_site_category_params")
}

// پارامتر ویژگی مخصوص هر سایت -- دو‌جوره:
// ۱) value پر باشه: این mapping فقط برای همون مقدار خاصه (جنسیت=مردانه -> paramTemplate="wg=2")
// ۲) value خالی (null) باشه: یه قالب عمومیه که با جایگزینی {value} روی هر مقداری از
//    این ویژگی اعمال می‌شه (سایز -> paramTemplate="vr=size|group-{value}", برای L میشه vr=size|group-l)
model ExternalSiteAttributeParam {
  id            String  @id @default(cuid())
  siteId        String
  attributeId   String
  value         String? // مقدار خاص (مثلاً "مردانه") یا null برای قالب عمومی
  paramTemplate String // معمولاً پارامتر کامل مثل "wg=2" -- ولی وقتی sharedKey پر
  // باشه، این فقط بخش تبدیل مقدار میشه (مثلاً "group-{value}" یا "{value}-yas")،
  // نه کل پارامتر
  sharedKey     String? // وقتی چندتا ویژگی (مثلاً «سایز حرفی»، «سایز عددی»، «سایز
  // سنی») باید زیر یه کلید مشترک ترکیب بشن (مثلاً "vr=size|") -- طبق نمونه‌ی واقعی
  // ترندیول: vr=size|group-l_32_10-yas (هرکدوم با paramTemplate خودشون تبدیل و
  // با _ به‌هم چسبیده می‌شن، sharedKey فقط یه‌بار جلوشون میاد)
  isDefault     Boolean @default(false) // تیک «به عنوان صفحه‌ی اول» -- فقط برای ردیف‌هایی
  // که value مشخص دارن معنی داره (نه قالب عمومی، چون قالب عمومی مقدار ثابتی نداره)

  site      ExternalSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  attribute Attribute    @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([siteId, attributeId, value])
  @@map("external_site_attribute_params")
}

// ================= نشست‌های فعال دستگاه (مدیریت حساب چنددستگاهی) =================
// هر ورود از یک دستگاه، یک ردیف (کلید: userId + deviceId). وقتی همان دستگاه دوباره
// وارد می‌شود ردیف به‌روز می‌شود (sid جدید) و به‌عنوان «همان دستگاه» شناخته می‌شود؛
// دستگاهی که هیچ ردیف قبلی ندارد «دستگاه جدید» است و به‌کاربر اعلان می‌دهیم.
model UserSession {
  id         String   @id @default(cuid())
  userId     String
  sid        String   @unique // داخل JWT ذخیره می‌شود؛ برای لغو یک‌نشست و «خروج از همه»
  deviceId   String // fingerprint دستگاه (کوکی device_id) -- برای تشخیص دستگاه جدید
  userAgent  String?
  ip         String?
  isCurrent  Boolean  @default(false) // آخرین دستگاهی که الان با آن وارد شده
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  revokedAt  DateTime? // اگر پُر باشد یعنی این دستگاه دیگر مجاز به استفاده نیست

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("user_sessions")
}

// ================= مجله/بلاگ =================

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String? // خلاصه‌ی کوتاه -- توی لیستِ مجله و متاتگِ سئو استفاده می‌شه
  coverImage  String?
  body        String // متن کامل -- پاراگراف‌ها با خط خالی (\n\n) جدا می‌شن، مثل بقیه‌ی متن‌های سایت
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("blog_posts")
}

// ================= ارسالی مشتریان (UGC گلچین‌شده توسط ادمین) =================

model CustomerShipment {
  id          String   @id @default(cuid())
  image       String // عکسِ ارسالیِ مشتری (آپلود به /uploads/customer-shipments)
  caption     String? // توضیحِ کوتاهِ ادمین (مثلاً «ارسالی خانم احمدی - تهران»)
  productId   String? // لینک به محصولِ مزون (اختیاری)
  externalId  String? // لینک به محصولِ خارجی (اختیاری)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("customer_shipments")
}
